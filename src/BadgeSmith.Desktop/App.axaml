<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BadgeSmith.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="ClockIcon">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,4.5 L8,8 L10.5,9.5</StreamGeometry>
      <StreamGeometry x:Key="CardIcon">M4.5,1.5 L11.5,1.5 L11.5,14.5 L4.5,14.5 Z M6.5,5 L9.5,5</StreamGeometry>
      <StreamGeometry x:Key="TrophyIcon">M4.5,1.5 L11.5,1.5 L11.5,5.5 A3.5,3.5 0 0 1 4.5,5.5 Z M4.5,3 L2,3 L2,4.5 A2.5,2.5 0 0 0 4.7,7 M11.5,3 L14,3 L14,4.5 A2.5,2.5 0 0 1 11.3,7 M8,9 L8,11.5 M5,14.5 L11,14.5 L11,11.5 L5,11.5 Z</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#DFE1E6" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FFF1C2" />
          <SolidColorBrush x:Key="IconBrush" Color="#4A4D55" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1A1B1E" />
          <SolidColorBrush x:Key="CardBrush" Color="#24262A" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#33363C" />
          <SolidColorBrush x:Key="WarningBrush" Color="#4D3D12" />
          <SolidColorBrush x:Key="IconBrush" Color="#B9BCC3" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="ListBox.log ListBoxItem">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Application.Styles>
</Application>
