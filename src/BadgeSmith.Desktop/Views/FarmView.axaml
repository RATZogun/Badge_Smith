<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadgeSmith.Desktop.ViewModels"
             xmlns:services="using:BadgeSmith.Desktop.Services"
             x:Class="BadgeSmith.Desktop.Views.FarmView"
             x:DataType="vm:FarmViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="ClockIcon">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,4.5 L8,8 L10.5,9.5</StreamGeometry>
    <StreamGeometry x:Key="CardIcon">M4.5,1.5 L11.5,1.5 L11.5,14.5 L4.5,14.5 Z M6.5,5 L9.5,5</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.pill">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#B3000000" />
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill Path">
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.poster.ignored Image">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto,100" Margin="8,12,8,0">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="15" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Atualizar" Command="{Binding RefreshCommand}" />
        <Button Content="Iniciar" Classes="accent" Command="{Binding StartCommand}" IsVisible="{Binding IsIdle}" />
        <Button Content="Retomar" Classes="accent" Command="{Binding StartCommand}" IsVisible="{Binding IsPaused}" />
        <Button Content="Pausar" Command="{Binding PauseCommand}" IsVisible="{Binding IsRunning}" />
        <Button Content="Parar" Command="{Binding StopCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="warning" Margin="0,12,0,0"
            IsVisible="{Binding LimitedWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding LimitedWarning}" TextWrapping="Wrap" />
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
      <ItemsControl ItemsSource="{Binding Games}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FarmGameViewModel">
            <Grid Classes="poster" Classes.ignored="{Binding IsBlacklisted}" Width="180" Height="270" Margin="0,0,12,12"
                  Background="{DynamicResource CardBrush}" ClipToBounds="True">
              <TextBlock Text="{Binding Name}" Margin="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                         TextAlignment="Center" Classes="muted"
                         IsVisible="{Binding Poster, Converter={x:Static ObjectConverters.IsNull}}" />
              <Image Source="{Binding Poster}" Stretch="UniformToFill" />
              <Border VerticalAlignment="Bottom" Padding="10,36,10,8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.4" Color="#B0000000" />
                    <GradientStop Offset="1" Color="#E8000000" />
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                             MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Status}" Foreground="#D9FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Status}" />
                  <CheckBox Content="Ignorar" Foreground="White" FontSize="11" MinHeight="0" Padding="6,0,0,0"
                            IsChecked="{Binding IsBlacklisted}" IsEnabled="{Binding CanChangeBlacklist}"
                            ToolTip.Tip="Não farmar este jogo" />
                </StackPanel>
              </Border>
              <Border Classes="pill" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Data="{StaticResource ClockIcon}" />
                  <TextBlock Text="{Binding HoursPlayed, Converter={x:Static services:PlayTime.Converter}}" />
                </StackPanel>
              </Border>
              <Border Classes="pill" HorizontalAlignment="Right" ToolTip.Tip="Cartas a dropar">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Data="{StaticResource CardIcon}" />
                  <TextBlock Text="{Binding RemainingDrops}" />
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Classes="muted" Text="Registro" Margin="4,12,0,4" />
    <Border Grid.Row="4" Classes="card" Padding="8" Margin="0,0,0,8">
      <ListBox Classes="log" ItemsSource="{Binding Log}" Background="Transparent" FontSize="12" />
    </Border>
  </Grid>
</UserControl>
