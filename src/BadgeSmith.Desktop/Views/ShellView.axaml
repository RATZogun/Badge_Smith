<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadgeSmith.Desktop.ViewModels"
             xmlns:views="using:BadgeSmith.Desktop.Views"
             x:Class="BadgeSmith.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="20,14,20,6">
      <TextBlock Classes="title" Text="Badge Smith" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0"
                 Text="{Binding AccountName, StringFormat='Conta: {0}'}" />
      <Button Grid.Column="2" Content="Sair" Command="{Binding LogoutCommand}" />
    </Grid>
    <Border DockPanel.Dock="Top" Classes="warning" Margin="20,6" IsVisible="{Binding AccountWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding AccountWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Verificar de novo" Margin="12,0,0,0" Command="{Binding RecheckAccountCommand}" />
      </Grid>
    </Border>
    <TabControl Margin="12,0,12,12">
      <TabItem Header="Cartas">
        <views:FarmView DataContext="{Binding Farm}" />
      </TabItem>
      <TabItem Header="Conquistas">
        <views:AchievementsView DataContext="{Binding Achievements}" />
      </TabItem>
      <TabItem Header="Configurações">
        <views:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
