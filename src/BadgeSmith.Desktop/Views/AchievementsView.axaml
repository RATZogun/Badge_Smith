<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadgeSmith.Desktop.ViewModels"
             xmlns:steam="using:BadgeSmith.Steam"
             x:Class="BadgeSmith.Desktop.Views.AchievementsView"
             x:DataType="vm:AchievementsViewModel">
  <Grid ColumnDefinitions="300,*" Margin="8,12,8,8">
    <DockPanel Margin="0,0,12,0">
      <TextBox DockPanel.Dock="Top" PlaceholderText="Buscar jogo ou appId" Text="{Binding Filter}" />
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,8">
        <TextBlock Classes="muted" FontSize="12" Text="{Binding GamesSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Recarregar" FontSize="12" Command="{Binding LoadGamesCommand}" />
      </Grid>
      <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="{DynamicResource CardBrush}" CornerRadius="8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="steam:OwnedGame">
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding HoursPlayed, StringFormat='{}{0:0.0} h jogadas'}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <TextBlock Classes="title" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding SelectedGame.Name, FallbackValue='Escolha um jogo'}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasGame}">
          <Button Content="Marcar todas" Command="{Binding CheckAllCommand}" />
          <Button Content="Desmarcar todas" Command="{Binding UncheckAllCommand}" />
          <Button Content="Recarregar" Command="{Binding ReloadCommand}" />
          <Button Content="Gravar" Classes="accent" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Margin="0,8" TextWrapping="Wrap" Text="{Binding Message}"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,4" />
      <ListBox ItemsSource="{Binding Achievements}" Margin="0,8,0,0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AchievementItemViewModel">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="2" Margin="4,4,0,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Status}" />
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="alteração pendente" IsVisible="{Binding IsChanged}"
                             Foreground="{DynamicResource SystemAccentColor}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
