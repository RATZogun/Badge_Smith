<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadgeSmith.Desktop.ViewModels"
             xmlns:services="using:BadgeSmith.Desktop.Services"
             x:Class="BadgeSmith.Desktop.Views.AchievementsView"
             x:DataType="vm:AchievementsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.achievementIcon">
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="300,*" Margin="8,12,8,8">
    <DockPanel Margin="0,0,12,0">
      <TextBox DockPanel.Dock="Top" PlaceholderText="Buscar jogo ou appId" Text="{Binding Filter}" />
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,8">
        <TextBlock Classes="muted" FontSize="12" Text="{Binding GamesSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Recarregar" FontSize="12" Command="{Binding LoadGamesCommand}" />
      </Grid>
      <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="{DynamicResource CardBrush}" CornerRadius="8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GameItemViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="32" Height="32" Background="{DynamicResource CardBorderBrush}" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="muted" FontSize="12"
                             Text="{Binding HoursPlayed, Converter={x:Static services:PlayTime.Converter}, StringFormat='{}{0} jogadas'}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,4,0" IsVisible="{Binding HasProgress}" ToolTip.Tip="Conquistas desbloqueadas">
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}" Width="48" TextAlignment="Right" />
                    <Path Data="{StaticResource TrophyIcon}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4"
                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <TextBlock Classes="title" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding SelectedGame.Name, FallbackValue='Escolha um jogo'}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasGame}">
          <Button Content="Marcar todas" Command="{Binding CheckAllCommand}" />
          <Button Content="Desmarcar todas" Command="{Binding UncheckAllCommand}" />
          <Button Content="Recarregar" Command="{Binding ReloadCommand}" />
          <Button Content="Gravar" Classes="accent" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Margin="0,8" TextWrapping="Wrap" Text="{Binding Message}"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,4" />
      <ListBox ItemsSource="{Binding Achievements}" Margin="0,8,0,0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AchievementItemViewModel">
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="achievementIcon" Width="56" Height="56"
                      Margin="4,0,12,0" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Status}" />
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="alteração pendente" IsVisible="{Binding IsChanged}"
                             Foreground="{DynamicResource SystemAccentColor}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
